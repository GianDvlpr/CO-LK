  import    ImportJob @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, rowNumber])
  @@map("import_errors")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  type      String
  title     String
  message   String
  data      Json?
