  @@unique([productionOrderId, componentType])
  @@index([itemId])
  @@map("production_components")
}

model Customer {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  code           String
  name           String
  taxId          String?         @map("tax_id")
  documentType   TaxDocumentType @default(RUC) @map("document_type")
