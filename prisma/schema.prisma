}

model SalesOrder {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  customerId       String            @map("customer_id") @db.Uuid
  number           String
  status           SalesOrderStatus  @default(DRAFT)
  requestedAt      DateTime          @map("requested_at") @db.Date
  promisedAt       DateTime?         @map("promised_at") @db.Date
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id])
  lines            SalesOrderLine[]
  pickPackOrder    PickPackOrder?
  productionOrders ProductionOrder[]

  @@unique([companyId, number])
  @@index([companyId, status, requestedAt])
  @@map("sales_orders")
}

model SalesOrderLine {
  id                String           @id @default(uuid()) @db.Uuid
  salesOrderId      String           @map("sales_order_id") @db.Uuid
  productVariantId  String           @map("product_variant_id") @db.Uuid
  productionOrderId String?          @map("production_order_id") @db.Uuid
  quantity          Decimal          @db.Decimal(18, 6)
  unitPrice         Decimal          @default(0) @map("unit_price") @db.Decimal(18, 4)
  salesOrder        SalesOrder       @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productVariant    ProductVariant   @relation(fields: [productVariantId], references: [id])
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  pickPackLine      PickPackLine?

  @@index([salesOrderId, productVariantId])
  @@map("sales_order_lines")
}

model PickPackOrder {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  salesOrderId     String            @unique @map("sales_order_id") @db.Uuid
  warehouseId      String            @map("warehouse_id") @db.Uuid
  number           String
  priority         PickPackPriority  @default(NORMAL)
  status           PickPackStatus    @default(PENDING)
  startedAt        DateTime?         @map("started_at")
  packingStartedAt DateTime?         @map("packing_started_at")
  readyAt          DateTime?         @map("ready_at")
  dispatchedAt     DateTime?         @map("dispatched_at")
  carrier          String?
  shippingDocument String?           @map("shipping_document")
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrder       SalesOrder        @relation(fields: [salesOrderId], references: [id])
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  lines            PickPackLine[]
  packages         PickPackPackage[]

  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
  @@map("pick_pack_orders")
}

model PickPackLine {
  id                String                @id @default(uuid()) @db.Uuid
  pickPackOrderId   String                @map("pick_pack_order_id") @db.Uuid
  salesOrderLineId  String                @unique @map("sales_order_line_id") @db.Uuid
  warehouseLocation String?               @map("warehouse_location")
  lotCode           String?               @map("lot_code")
  requestedQuantity Decimal               @map("requested_quantity") @db.Decimal(18, 6)
  pickedQuantity    Decimal               @default(0) @map("picked_quantity") @db.Decimal(18, 6)
  packedQuantity    Decimal               @default(0) @map("packed_quantity") @db.Decimal(18, 6)
  incidentType      PickPackIncidentType? @map("incident_type")
  incidentReason    String?               @map("incident_reason")
  notes             String?
  pickPackOrder     PickPackOrder         @relation(fields: [pickPackOrderId], references: [id], onDelete: Cascade)
  salesOrderLine    SalesOrderLine        @relation(fields: [salesOrderLineId], references: [id])

  @@index([pickPackOrderId])
  @@map("pick_pack_lines")
}

model PickPackPackage {
  id              String        @id @default(uuid()) @db.Uuid
  pickPackOrderId String        @map("pick_pack_order_id") @db.Uuid
  packageNumber   Int           @map("package_number")
  packageType     String?       @map("package_type")
  weight          Decimal?      @db.Decimal(18, 3)
  length          Decimal?      @db.Decimal(18, 2)
  width           Decimal?      @db.Decimal(18, 2)
  height          Decimal?      @db.Decimal(18, 2)
  notes           String?
  pickPackOrder   PickPackOrder @relation(fields: [pickPackOrderId], references: [id], onDelete: Cascade)

  @@unique([pickPackOrderId, packageNumber])
  @@map("pick_pack_packages")
}

model CalendarEvent {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @map("company_id") @db.Uuid
  createdById     String                @map("created_by_id") @db.Uuid
