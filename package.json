{
  "name": "lk-innovacion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sandbox": "node --require ./scripts/vitest-sandbox-preload.cjs ./node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:sandbox": "node --require ./scripts/vitest-sandbox-preload.cjs ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy-neon": "node scripts/deploy-migrations-neon.mjs",
    "db:bootstrap-neon": "node scripts/bootstrap-neon.mjs",
    "db:seed": "prisma db seed",
    "db:seed-neon": "node scripts/seed-neon.mjs",
    "demo:seed": "node --experimental-strip-types prisma/demo-data.ts",
    "demo:cleanup": "node --experimental-strip-types prisma/demo-data.ts --cleanup",
    "exchange-rates:sync": "node scripts/sync-exchange-rates-neon.mjs",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@ant-design/icons": "6.2.5",
    "@ant-design/nextjs-registry": "1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@neondatabase/serverless": "^1.2.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.100.14",
    "antd": "6.4.3",
    "cloudinary": "2.11.0",
    "dayjs": "1.11.23",
    "decimal.js": "^10.6.0",
    "exceljs": "4.4.0",
    "next": "16.2.6",
    "pusher": "5.3.4",
    "pusher-js": "8.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.90.0",
    "sonner": "2.0.8",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "dotenv": "^17.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.6",
    "jsdom": "30.1.2",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
